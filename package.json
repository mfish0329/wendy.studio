{
  "name": "wendy-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:tech": "pnpm --filter @wendy/tech dev",
    "dev:friendly": "pnpm --filter @wendy/friendly dev",
    "dev:legal": "pnpm --filter @wendy/legal dev",
    "dev:commerce": "pnpm --filter @wendy/commerce dev"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
